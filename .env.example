# Neon PostgreSQL. Copy this file to .env and fill in the values (.env is git-ignored).
# Use the development branch's connection strings locally; production values
# belong in the hosting provider's environment settings.

# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string. Used by `prisma migrate`. Optional:
# when unset, it is derived from DATABASE_URL by removing "-pooler" from the host.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
